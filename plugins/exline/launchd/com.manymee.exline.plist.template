<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.manymee.exline</string>

    <key>ProgramArguments</key>
    <array>
        <string>__BIN__</string>
        <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__WORKDIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG__</string>

    <key>StandardErrorPath</key>
    <string>__LOG__</string>

    <!-- Interactive: the daemon renders the user-facing statusline; Background
         QoS gets throttled hardest exactly when the machine is busy, which made
         the daemon unreachable under load. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- launchd defaults to 256 open files; statusline poll bursts during a
         git slowdown exceed that and crash the daemon with emfile. -->
    <key>SoftResourceLimits</key>
    <dict>
        <key>NumberOfFiles</key>
        <integer>4096</integer>
    </dict>
</dict>
</plist>
